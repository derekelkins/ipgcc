#![allow(non_snake_case)]
#![allow(dead_code)]
#![allow(unreachable_code)]
#![allow(unused_mut)]
#![allow(unused_assignments)]
#![allow(unused_variables)]
#![allow(non_camel_case_types)]

type AString = String;

fn decodeAscii(bytes: &[u8]) -> String { String::from(std::str::from_utf8(bytes).unwrap()) }
fn decodeAscii2(bytes: &[u8]) -> String { String::from(std::str::from_utf8(bytes).unwrap()) }
fn length<a>(xs: &[a]) -> usize { xs.len() }
fn asHex(bs: &[u8]) -> String { format!("{:02X?}", bs) }

// TODO: The variants should really be records rather than tuples, but I don't feel like
// making the adapter functions.
#[derive(Clone, Debug)]
enum TaggedVolumeDescriptor {
    Primary(
        /* systemIdentifier: */ String,
        /* volumeIdentifier: */ String,
        /* volumeSpaceSize: */  i64,
        /* volumeSetSize: */  i64,
        /* volumeSequenceNumber: */  i64,
        /* logicalBlockSize: */  i64,
        /* pathTableSize: */  i64,
        /* locationOfTypeLPathTable: */  i64,
        /* locationOfOptionalTypeLPathTable: */  i64,
        /* locationOfTypeMPathTable: */  i64,
        /* locationOfOptionalTypeMPathTable: */  i64,
        /* rootDirectoryRecord: */ DirectoryRecord,
        /* volumeSetIdentifier: */ String,
        /* publisherIdentifier: */ String,
        /* dataPreparerIdentifier: */ String,
        /* applicationIdentifier: */ String,
        /* copyrightFileIdentifier: */ String,
        /* abstractFileIdentifier: */ String,
        /* bibliographicFileIdentifier: */ String,
        /* volumeCreationDateAndTime: */ DateAndTime,
        /* volumeModificationDateAndTime: */ DateAndTime,
        /* volumeExpirationDateAndTime: */ DateAndTime,
        /* volumeEffectiveDateAndTime: */ DateAndTime,
        /* applicationUse: */ String),
    Supplementary(
        /* volumeDescriptorVersion: */ u8,
        /* volumeFlags: */ u8,
        /* systemIdentifier: */ String,
        /* volumeIdentifier: */ String,
        /* volumeSpaceSize: */ i64,
        /* escapeSequences: */ String,
        /* volumeSetSize: */ i64,
        /* volumeSequenceNumber: */ i64,
        /* logicalBlockSize: */ i64,
        /* pathTableSize: */ i64,
        /* locationOfTypeLPathTable: */ i64,
        /* locationOfOptionalTypeLPathTable: */ i64,
        /* locationOfTypeMPathTable: */ i64,
        /* locationOfOptionalTypeMPathTable: */ i64,
        /* rootDirectoryRecord: */ DirectoryRecord,
        /* volumeSetIdentifier: */ String,
        /* publisherIdentifier: */ String,
        /* dataPreparerIdentifier: */ String,
        /* applicationIdentifier: */ String,
        /* copyrightFileIdentifier: */ String,
        /* abstractFileIdentifier: */ String,
        /* bibliographicFileIdentifier: */ String,
        /* volumeCreationDateAndTime: */ DateAndTime,
        /* volumeModificationDateAndTime: */ DateAndTime,
        /* volumeExpirationDateAndTime: */ DateAndTime,
        /* volumeEffectiveDateAndTime: */ DateAndTime,
        /* fileStructureVersion: */ u8,
        /* applicationUse: */ String),
    VolumePartition(String, String, i64, i64, String),
    Boot(String, String, String),
    Terminator(),
    Unknown(Vec<u8>),
}
use TaggedVolumeDescriptor::*;

#[derive(Clone, Debug)]
enum DirectoryTree {
    DirectoryBranch(i64, DirectoryRecord, Vec<DirectoryTree>),
    FileLeaf(i64, DirectoryRecord),
}
use DirectoryTree::*;

fn projectRoot(drs: Vec<DirectoriesRecursive>) -> Vec<DirectoryTree> {
    drs.into_iter().map(|dr| dr.root).collect()
}

fn getPrimaryDescriptor(descriptors: &[TaggedVolumeDescriptor]) -> TaggedVolumeDescriptor {
    for descriptor in descriptors.iter() {
        match descriptor {
            pvd @ Primary(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _)
            => {
                return pvd.clone();
            }
            _ => {}
        }
    }
    panic!("Couldn't find a primary descriptor")
}

fn logicalBlockSize(descriptor: &TaggedVolumeDescriptor) -> i64 {
    match descriptor {
        Primary(
            _,
            _,
            _,
            _,
            _,
            logicalBlockSizeField,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _
        ) => *logicalBlockSizeField,
        _ => { panic!("Expected Primary") }
    }
}
fn rootDirectoryRecord(descriptor: &TaggedVolumeDescriptor) -> DirectoryRecord {
    match descriptor {
        Primary(
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            rootDirectoryRecordField,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _
        ) => rootDirectoryRecordField.clone(),
        _ => { panic!("Expected Primary") }
    }
}
fn locationOfTypeLPathTable(descriptor: &TaggedVolumeDescriptor) -> i64 {
    match descriptor {
        Primary(
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            locationOfTypeLPathTableField,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _
        ) => *locationOfTypeLPathTableField,
        _ => { panic!("Expected Primary") }
    }
}
fn pathTableSize(descriptor: &TaggedVolumeDescriptor) -> i64 {
    match descriptor {
        Primary(
            _,
            _,
            _,
            _,
            _,
            _,
            pathTableSizeField,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _,
            _
        ) => *pathTableSizeField,
        _ => { panic!("Expected Primary") }
    }
}
fn isDirectory(record: &DirectoryRecord) -> bool { record.isDirectory }
fn locationOfExtent(record: &DirectoryRecord) -> i64 { record.locationOfExtent }
fn dataLength(record: &DirectoryRecord) -> i64 { record.dataLength }
fn locationOfExtentPT(record: &PathTableRecord) -> i64 { record.locationOfExtent }
fn clone<a: Clone>(x: &a) -> a { x.clone() }

%preamble_end

%declare_type AString TaggedVolumeDescriptor DirectoryTree %end

function DirectoryBranch(
    offset: Int, record: DirectoryRecord, children: [DirectoryTree]
): DirectoryTree;
function FileLeaf(offset: Int, record: DirectoryRecord): DirectoryTree;
function Primary(
    systemIdentifier: AString,
    volumeIdentifier: AString,
    volumeSpaceSize:  Int,
    volumeSetSize:  Int,
    volumeSequenceNumber:  Int,
    logicalBlockSize:  Int,
    pathTableSize:  Int,
    locationOfTypeLPathTable:  Int,
    locationOfOptionalTypeLPathTable:  Int,
    locationOfTypeMPathTable:  Int,
    locationOfOptionalTypeMPathTable:  Int,
    rootDirectoryRecord: DirectoryRecord,
    volumeSetIdentifier: AString,
    publisherIdentifier: AString,
    dataPreparerIdentifier: AString,
    applicationIdentifier: AString,
    copyrightFileIdentifier: AString,
    abstractFileIdentifier: AString,
    bibliographicFileIdentifier: AString,
    volumeCreationDateAndTime: DateAndTime,
    volumeModificationDateAndTime: DateAndTime,
    volumeExpirationDateAndTime: DateAndTime,
    volumeEffectiveDateAndTime: DateAndTime,
    applicationUse: AString
): TaggedVolumeDescriptor;
function Supplementary(
    volumeDescriptorVersion: U8,
    volumeFlags: U8,
    systemIdentifier: AString,
    volumeIdentifier: AString,
    volumeSpaceSize: Int,
    escapeSequences: AString,
    volumeSetSize: Int,
    volumeSequenceNumber: Int,
    logicalBlockSize: Int,
    pathTableSize: Int,
    locationOfTypeLPathTable: Int,
    locationOfOptionalTypeLPathTable: Int,
    locationOfTypeMPathTable: Int,
    locationOfOptionalTypeMPathTable: Int,
    rootDirectoryRecord: DirectoryRecord,
    volumeSetIdentifier: AString,
    publisherIdentifier: AString,
    dataPreparerIdentifier: AString,
    applicationIdentifier: AString,
    copyrightFileIdentifier: AString,
    abstractFileIdentifier: AString,
    bibliographicFileIdentifier: AString,
    volumeCreationDateAndTime: DateAndTime,
    volumeModificationDateAndTime: DateAndTime,
    volumeExpirationDateAndTime: DateAndTime,
    volumeEffectiveDateAndTime: DateAndTime,
    fileStructureVersion: U8,
    applicationUse: AString
): TaggedVolumeDescriptor;
function VolumePartition(
    systemIdentifier: AString,
    volumePartitionIdentifier: AString,
    volumePartitionLocation: Int,
    volumePartitionSize: Int,
    systemUse: AString): TaggedVolumeDescriptor;
function Boot(
    bootSystemIdentifier: AString,
    bootIdentifier: AString,
    systemUse: AString
): TaggedVolumeDescriptor;
function Terminator(): TaggedVolumeDescriptor;
function Unknown(bytes: String): TaggedVolumeDescriptor;
function decodeAscii(bytes: String): AString;
function decodeAscii2(bytes: [U8]): AString;
function length(xs: ['a]): Int;
function asHex(bs: String): AString;
function projectRoot(drs: [DirectoriesRecursive]): [DirectoryTree];
function logicalBlockSize(descriptor: TaggedVolumeDescriptor): Int;
function rootDirectoryRecord(descriptor: TaggedVolumeDescriptor): DirectoryRecord;
function locationOfTypeLPathTable(descriptor: TaggedVolumeDescriptor): Int;
function pathTableSize(descriptor: TaggedVolumeDescriptor): Int;
function isDirectory(record: DirectoryRecord): Bool;
function locationOfExtent(record: DirectoryRecord): Int;
function dataLength(record: DirectoryRecord): Int;
function locationOfExtentPT(record: PathTableRecord): Int;
function getPrimaryDescriptor(descriptors: [TaggedVolumeDescriptor]): TaggedVolumeDescriptor;
function clone(x: 'a): 'a;

function ref(x: 'a): 'a;
typedef Ref('a) = 'a;

// Based on ECMA-119 5th Ed. December 2024
// https://ecma-international.org/publications-and-standards/standards/ecma-119/

const LOGICAL_SECTOR_SIZE = 2048; // In theory this could be a higher power of 2.

// The System Area plus the Data Area form the Volume Space which is effectively the whole file.
// Logical blocks count from the beginning of the Volume Space and start at 0.
// The logical block size for the volume is stored in the volume descriptors.

ISO9660
    -> // The first 16 logical sector (0-15) are the System Area and are unspecified.
       // SystemArea[0, 16*LOGICAL_SECTOR_SIZE]
       // The Data Area begins at Logical Sector 16.
       VolumeDescriptors[16*LOGICAL_SECTOR_SIZE, EOI]
       { descriptors = VolumeDescriptors.values }

       { primaryDescriptor = getPrimaryDescriptor(ref(descriptors)) }
       { logicalBlockSize = logicalBlockSize(ref(primaryDescriptor)) }

       // Get directory structure from the DirectoryRecords.
       // The following approach via the LPathTable is simpler and probably better,
       // but this approach illustrates a non-trivial use of absolute offsets.
       DirectoriesRecursive(logicalBlockSize, rootDirectoryRecord(ref(primaryDescriptor)))[0, EOI]
       { directoriesRecursive = DirectoriesRecursive.root }

       // Get directory structure from the LPathTable.
       { pathTableLocation = locationOfTypeLPathTable(ref(primaryDescriptor)) }
       { pathTableSize = pathTableSize(ref(primaryDescriptor)) }
       { pathTableOffset = logicalBlockSize * pathTableLocation }
       LPathTableRecords[pathTableOffset, pathTableOffset + pathTableSize]
       { paths = LPathTableRecords.values }
       for i = 0 to length(ref(paths)) do
         DirectoryRecords[logicalBlockSize*locationOfExtentPT(ref(paths[i])),
                          logicalBlockSize*locationOfExtentPT(ref(paths[i])) + LOGICAL_SECTOR_SIZE]
       { directories = DirectoryRecords.these };

// Volume descriptors are stored at the start of each logical sector.
// So the first volume descriptor is at logical sector 16 (offset 32,768).
// The next is at logical sector 17 (offset 34,816 = 32,768 + 2,048).
VolumeDescriptors
    -> repeat VolumeDescriptor[VolumeDescriptor.START + LOGICAL_SECTOR_SIZE,
                               VolumeDescriptor.START + 2*LOGICAL_SECTOR_SIZE].descriptor
       starting on [0, LOGICAL_SECTOR_SIZE] until VolumeDescriptorSetTerminator;

typedef VolumeDescriptor = { descriptor: TaggedVolumeDescriptor };

// 9.1
rule VolumeDescriptor: VolumeDescriptor;
VolumeDescriptor
    -> PrimaryVolumeDescriptor { descriptor = PrimaryVolumeDescriptor.descriptor }
     / SupplementaryOrEnhancedVolumeDescriptor
       { descriptor = SupplementaryOrEnhancedVolumeDescriptor.descriptor }
     / VolumePartitionDescriptor { descriptor = VolumePartitionDescriptor.descriptor }
     / BootRecord { descriptor = BootRecord.descriptor }
     / VolumeDescriptorSetTerminator { descriptor = VolumeDescriptorSetTerminator.descriptor }
     / UnknownVolumeDescriptor { descriptor = UnknownVolumeDescriptor.descriptor };

// 9.4
rule PrimaryVolumeDescriptor: VolumeDescriptor;
PrimaryVolumeDescriptor
    -> "\x01CD001\x01\x00"
       AChars[32] { systemIdentifier = AChars.value }
       DChars[32] { volumeIdentifier = DChars.value }
       NULBytes[8] // unused
       BB_U32 { volumeSpaceSize = BB_U32.value } // Number of Logical Blocks in volume
       NULBytes[32] // unused
       BB_U16[4] { volumeSetSize = BB_U16.value }
       BB_U16[4] { volumeSequenceNumber = BB_U16.value }
       BB_U16[4] { logicalBlockSize = BB_U16.value }
       BB_U32[8] { pathTableSize = BB_U32.value } // In bytes
       LE_U32[4] { locationOfTypeLPathTable = LE_U32.value } // Path table using LE numbers
       LE_U32[4] { locationOfOptionalTypeLPathTable = LE_U32.value } // These are Logical Block Numbers.
       BE_U32[4] { locationOfTypeMPathTable = BE_U32.value } // Path table using BE numbers
       BE_U32[4] { locationOfOptionalTypeMPathTable = BE_U32.value }
       DirectoryRecord[34] { rootDirectoryRecord = DirectoryRecord.this }
       DChars[190, 318] { volumeSetIdentifier = DChars.value }
       AChars[128] { publisherIdentifier = AChars.value }
       AChars[128] { dataPreparerIdentifier = AChars.value }
       AChars[128] { applicationIdentifier = AChars.value }
       DChars[37] { copyrightFileIdentifier = DChars.value } // d-characters, SEPARATOR 1, SEPARATOR 2
       DChars[37] { abstractFileIdentifier = DChars.value } // Ditto
       DChars[37] { bibliographicFileIdentifier = DChars.value } // Ditto
       DateAndTime[17] { volumeCreationDateAndTime = DateAndTime.this }
       DateAndTime[17] { volumeModificationDateAndTime = DateAndTime.this }
       DateAndTime[17] { volumeExpirationDateAndTime = DateAndTime.this }
       DateAndTime[17] { volumeEffectiveDateAndTime = DateAndTime.this }
       "\x01" // 1 for Primary or Supplementary, 2 for Enhanced. See 9.4.30.
       "\x00" // reserved
       HexBytes[512] { applicationUse = HexBytes.value }
       NULBytes // reserved
       { descriptor = Primary(
            systemIdentifier,
            volumeIdentifier,
            volumeSpaceSize,
            volumeSetSize,
            volumeSequenceNumber,
            logicalBlockSize,
            pathTableSize,
            locationOfTypeLPathTable,
            locationOfOptionalTypeLPathTable,
            locationOfTypeMPathTable,
            locationOfOptionalTypeMPathTable,
            rootDirectoryRecord,
            volumeSetIdentifier,
            publisherIdentifier,
            dataPreparerIdentifier,
            applicationIdentifier,
            copyrightFileIdentifier,
            abstractFileIdentifier,
            bibliographicFileIdentifier,
            volumeCreationDateAndTime,
            volumeModificationDateAndTime,
            volumeExpirationDateAndTime,
            volumeEffectiveDateAndTime,
            applicationUse) };

// The differences between the Supplementary and Enhanced Volume Descriptors are
// largely ones of interpretation and lifted restrictions. The various textual
// fields, e.g. systemIdentifier, use a1-/d1-characters for Supplementary Volume
// Descriptors. For Enhanced Volume Descriptors its "subject to agreement between
// the originator and the recipient of the volume". I presume, in practice, this
// means using the Joliet specification and UCS-2 (UTF-16) characters. The Enhanced
// Volume Descriptor also removes some restrictions on directory depth and file name
// length that the Supplementary Volume Descriptor implies. Annex B is a good overview
// of the differences as it lists the differences between the 2nd and 4th edition, and
// the main change was the addition of the Enhanced Volume Descriptors.
// 9.5
rule SupplementaryOrEnhancedVolumeDescriptor: VolumeDescriptor;
SupplementaryOrEnhancedVolumeDescriptor
    -> "\x02CD001"
       { volumeDescriptorVersion = . }
       ?[ volumeDescriptorVersion == 1 || volumeDescriptorVersion == 2 ]
       // { descriptorType = volumeDescriptorVersion == 1 ? "Supplementary Volume Descriptor"
       //                                                 : "Enhanced Volume Descriptor" }
       { volumeFlags = . } // See 9.5.4
       AsciiString[32] { systemIdentifier = AsciiString.value } // a1-characters for Supplementary
       AsciiString[32] { volumeIdentifier = AsciiString.value } // d1-characters for Supplementary
       NULBytes[8] // unused
       BB_U32 { volumeSpaceSize = BB_U32.value }
       HexBytes[32] { escapeSequences = HexBytes.value } // See Annex C.3.
       BB_U16[4] { volumeSetSize = BB_U16.value }
       BB_U16[4] { volumeSequenceNumber = BB_U16.value }
       BB_U16[4] { logicalBlockSize = BB_U16.value }
       BB_U32[8] { pathTableSize = BB_U32.value }
       LE_U32[4] { locationOfTypeLPathTable = LE_U32.value } // Path table using LE numbers
       LE_U32[4] { locationOfOptionalTypeLPathTable = LE_U32.value }
       BE_U32[4] { locationOfTypeMPathTable = BE_U32.value } // Path table using BE numbers
       BE_U32[4] { locationOfOptionalTypeMPathTable = BE_U32.value }
       DirectoryRecord[34] { rootDirectoryRecord = DirectoryRecord.this }
       AsciiString[190, 318] { volumeSetIdentifier = AsciiString.value } // d1-characters for Supplementary
       AsciiString[128] { publisherIdentifier = AsciiString.value } // a1-characters for Supplementary
       AsciiString[128] { dataPreparerIdentifier = AsciiString.value } // a1-characters for Supplementary
       AsciiString[128] { applicationIdentifier = AsciiString.value } // a1-characters for Supplementary
       AsciiString[37] { copyrightFileIdentifier = AsciiString.value } // d1-characters, SEPARATOR 1, SEPARATOR 2 for Supplementary
       AsciiString[37] { abstractFileIdentifier = AsciiString.value } // d1-characters, SEPARATOR 1, SEPARATOR 2 for Supplementary
       AsciiString[37] { bibliographicFileIdentifier = AsciiString.value } // d1-characters, SEPARATOR 1, SEPARATOR 2 for Supplementary
       DateAndTime[17] { volumeCreationDateAndTime = DateAndTime.this }
       DateAndTime[17] { volumeModificationDateAndTime = DateAndTime.this }
       DateAndTime[17] { volumeExpirationDateAndTime = DateAndTime.this }
       DateAndTime[17] { volumeEffectiveDateAndTime = DateAndTime.this }
       { fileStructureVersion = . } // 1 for Primary or Supplementary, 2 for Enhanced. See 9.4.31.
       "\x00" // reserved
       HexBytes[512] { applicationUse = HexBytes.value }
       NULBytes // reserved
       { descriptor = Supplementary(
           volumeDescriptorVersion,
           volumeFlags,
           systemIdentifier,
           volumeIdentifier,
           volumeSpaceSize,
           escapeSequences,
           volumeSetSize,
           volumeSequenceNumber,
           logicalBlockSize,
           pathTableSize,
           locationOfTypeLPathTable,
           locationOfOptionalTypeLPathTable,
           locationOfTypeMPathTable,
           locationOfOptionalTypeMPathTable,
           rootDirectoryRecord,
           volumeSetIdentifier,
           publisherIdentifier,
           dataPreparerIdentifier,
           applicationIdentifier,
           copyrightFileIdentifier,
           abstractFileIdentifier,
           bibliographicFileIdentifier,
           volumeCreationDateAndTime,
           volumeModificationDateAndTime,
           volumeExpirationDateAndTime,
           volumeEffectiveDateAndTime,
           fileStructureVersion,
           applicationUse) };

// 9.6
rule VolumePartitionDescriptor: VolumeDescriptor;
VolumePartitionDescriptor
    -> "\x03CD001\x01\x00"
       AChars[32] { systemIdentifier = AChars.value }
       DChars[32] { volumePartitionIdentifier = DChars.value }
       BB_U32 { volumePartitionLocation = BB_U32.value } // Logical blocks
       BB_U32 { volumePartitionSize = BB_U32.value } // Number of Logical blocks
       HexBytes { systemUse = HexBytes.value }
       { descriptor = VolumePartition(
            systemIdentifier,
            volumePartitionIdentifier,
            volumePartitionLocation,
            volumePartitionSize,
            systemUse) };

// 9.2
rule BootRecord: VolumeDescriptor;
BootRecord
    -> "\x00CD001\x01"
       AChars[32] { bootSystemIdentifier = AChars.value }
       AChars[32] { bootIdentifier = AChars.value }
       HexBytes { systemUse = HexBytes.value }
       { descriptor = Boot(bootSystemIdentifier, bootIdentifier, systemUse) };

// 9.3
rule VolumeDescriptorSetTerminator: VolumeDescriptor;
VolumeDescriptorSetTerminator
    -> "\xFFCD001\x01"
       NULBytes // reserved
       { descriptor = Terminator() };

rule UnknownVolumeDescriptor: VolumeDescriptor;
UnknownVolumeDescriptor
    -> { typeByte = . } "CD001" { version = . } { data = * }
       { descriptor = Unknown(data) };

rule DirectoriesRecursive(logicalBlockSize: Int, node: DirectoryRecord): { root: DirectoryTree };
DirectoriesRecursive(logicalBlockSize, node)
    -> ?[ isDirectory(ref(node)) ]
       { offset = logicalBlockSize * locationOfExtent(ref(node)) }
       DirectoryRecords[offset, offset + dataLength(ref(node))]
       for i = 2 to length(ref(DirectoryRecords.values)) do // First two records are '.' and '..'.
         DirectoriesRecursive(logicalBlockSize, clone(ref(DirectoryRecords.values[i])))[0, EOI]
       { children = projectRoot(DirectoriesRecursive.these) }
       { root = DirectoryBranch(offset, node, children) }
     / { offset = logicalBlockSize * locationOfExtent(ref(node)) }
       { root = FileLeaf(offset, node) };

DirectoryRecords -> repeat DirectoryRecord.this;

typedef DirectoryRecord = {
    length: U8,
    extendedAttributeRecordLength: U8,
    locationOfExtent: Int,
    dataLength: Int,
    recordingDateAndTime: RecordingDateAndTime,
    isHidden: Bool,
    isDirectory: Bool,
    isAssociatedFile: Bool,
    isRecord: Bool,
    hasPermissions: Bool,
    isMultiExtent: Bool,
    fileUnitSize: U8,
    interleaveGapSize: U8,
    volumeSequenceNumber: Int,
    lengthOfFileIdentifier: U8,
    fileIdentifier: AString,
    systemUse: AString
};

// 10.1
rule DirectoryRecord: DirectoryRecord;
DirectoryRecord
    -> { length = . } ?[ length > 0 ]
       { extendedAttributeRecordLength = . }
       BB_U32 { locationOfExtent = BB_U32.value } // Logical Block number
       BB_U32 { dataLength = BB_U32.value } // Bytes, see 7.4.5
       RecordingDateAndTime[7] { recordingDateAndTime = RecordingDateAndTime.this }
       Byte // File Flags - See Table 10 in 10.1.7 (bits 5&6 are reserved and should be 0)
       { isHidden = (0x01 & Byte.value) != 0 } // Called Existence in the spec
       { isDirectory = (0x02 & Byte.value) != 0 }
       { isAssociatedFile = (0x04 & Byte.value) != 0 }
       { isRecord = (0x08 & Byte.value) != 0 }
       { hasPermissions = (0x10 & Byte.value) != 0 } // Called Protection in the spec
       { isMultiExtent = (0x80 & Byte.value) != 0 }
       { fileUnitSize = . }
       { interleaveGapSize = . }
       BB_U16 { volumeSequenceNumber = BB_U16.value }
       { lengthOfFileIdentifier = . }
       // d-characters, d1-characters, SEPARATOR 1, SEPARATOR 2, \x00, \x01
       // Presumably depending on what points to this directory record and whether this is a file
       // or directory as indicated by the fileFlags.
       // \x00 is '.' and \x01 is '..'
       AsciiString[lengthOfFileIdentifier] { fileIdentifier = AsciiString.value }
       EvenPadByte(lengthOfFileIdentifier)
       HexBytes[EvenPadByte.END, length] { systemUse = HexBytes.value };

typedef RecordingDateAndTime = { year: Int, month: U8, day: U8, hour: U8,
                                 minute: U8, second: U8, gmtOffset: U8 };

// Table 9 in 10.1.6
rule RecordingDateAndTime: RecordingDateAndTime;
RecordingDateAndTime
    -> Byte { year = Byte.value :: Int + 1900 }
       { month = . } // 1-12
       { day = . } // 1-31
       { hour = . } // 0-23
       { minute = . } // 0-59
       { second = . } // 0-59
       { gmtOffset = . }; // -48 to 52 in 15min increments

typedef PathTableRecord = {
    lengthOfDirectoryIdentifier: U8,
    extendedAttributeRecordLength: U8,
    locationOfExtent: Int,
    parentDirectoryNumber: Int,
    directoryIdentifier: AString
};

LPathTableRecords -> repeat LPathTableRecord.this;

// 10.4
rule LPathTableRecord: PathTableRecord;
LPathTableRecord
    -> { lengthOfDirectoryIdentifier = . }
       { extendedAttributeRecordLength = . }
       LE_U32 { locationOfExtent = LE_U32.value } // Logical block number
       LE_U16 { parentDirectoryNumber = LE_U16.value }
       AsciiString[lengthOfDirectoryIdentifier] // d-characters, or d1-characters
       { directoryIdentifier = AsciiString.value }
       OddPadByte(lengthOfDirectoryIdentifier);

MPathTableRecords -> repeat MPathTableRecord.this;

// 10.4
rule MPathTableRecord: PathTableRecord;
MPathTableRecord
    -> { lengthOfDirectoryIdentifier = . }
       { extendedAttributeRecordLength = . }
       BE_U32 { locationOfExtent = BE_U32.value } // Logical block number
       BE_U16 { parentDirectoryNumber = BE_U16.value }
       AsciiString[lengthOfDirectoryIdentifier] // d-characters, or d1-characters
       { directoryIdentifier = AsciiString.value }
       OddPadByte(lengthOfDirectoryIdentifier);

// 10.5
ExtendedAttributeRecord
    -> BB_U16 { ownerIdentification = BB_U16.value }
       BB_U16 { groupIdentification = BB_U16.value }
       BE_U16 { permissions = BE_U16.value } // 16-bit field See Table 13 in 10.5.4.
       DateAndTime { fileCreationDateAndTime = DateAndTime.this }
       DateAndTime { fileModificationDateAndTime = DateAndTime.this }
       DateAndTime { fileExpirationDateAndTime = DateAndTime.this }
       DateAndTime { fileEffectiveDateAndTime = DateAndTime.this }
       { recordFormat = . } // See 10.5.9
       { recordAttributes = . } // See 10.5.10
       BB_U16 { recordLength = BB_U16.value }
       AsciiString[32] { systemIdentifier = AsciiString.value } // a-characters, or a1-characters
       HexBytes[64] { systemUse = HexBytes.value }
       "\x01" // { extendedAttributeRecordVersion = .[180] }
       { lengthOfEscapeSequences = . }
       NULBytes[64] // reserved
       BB_U16 { lengthOfApplicationUse = BB_U16.value }
       HexBytes[lengthOfApplicationUse] { applicationUse = HexBytes.value }
       HexBytes[lengthOfEscapeSequences] { escapeSequences = HexBytes.value };

rule EvenPadByte(n: U8);
EvenPadByte(n) -> ?[ n % 2 == 0 ] "\x00" / ""; // 10.1.13

rule OddPadByte(n: U8);
OddPadByte(n) -> ?[ n % 2 == 1 ] "\x00" / ""; // 10.4.7

AsciiString -> { bytes = * } { value = decodeAscii(ref(bytes)) };

// See 8.4.1 and Annex A.
// SEPARATOR 1 is 0x2E ('.'), SEPARATOR 2 (';') is 0x3B and FILLER is 0x20 (' ')
AChars -> { bytes = * } { value = decodeAscii(ref(bytes)) }; // TODO: Actually check these are a-characters.
DChars -> { bytes = * } { value = decodeAscii(ref(bytes)) }; // TODO: Actually check these are d-characters.

typedef DateAndTime = {
    year: AString,
    month: AString,
    day: AString,
    hour: AString,
    minute: AString,
    second: AString,
    hundrethsOfSecond: AString,
    gmtOffset: U8
};

// Table 5 in 9.4.27.2
rule DateAndTime: DateAndTime;
DateAndTime
    -> Digits[4] { year = Digits.value }
       Digits[2] { month = Digits.value }
       Digits[2] { day = Digits.value }
       Digits[2] { hour = Digits.value }
       Digits[2] { minute = Digits.value }
       Digits[2] { second = Digits.value }
       Digits[2] { hundrethsOfSecond = Digits.value }
       { gmtOffset = . }; // Offset from GMT in 15min increments from -48 to 52.

Digits -> repeat Digit.value { value = decodeAscii2(ref(values)) };
Digit -> { value = . } ?[ value == 0 || value >= 0x30 && value <= 0x39 ];

HexBytes -> { bytes = * } { value = asHex(ref(bytes)) };

LE_U16 -> { b = *[2] } { value = (b[1] :: Int << 8) | (b[0] :: Int) }; // 8.2.2

BE_U16 -> { b = *[2] } { value = (b[0] :: Int << 8) | (b[1] :: Int) }; // 8.2.3

// Both-byte orders
BB_U16 -> LE_U16 BE_U16 ?[ LE_U16.value == BE_U16.value ] { value = LE_U16.value }; // 8.2.4

LE_U32 -> // 8.3.2
    { b = *[4] }
    { value = (b[3] :: Int << 24) | (b[2] :: Int << 16) | (b[1] :: Int << 8) | (b[0] :: Int) };

BE_U32 -> // 8.3.3
    { b = *[4] }
    { value = (b[0] :: Int << 24) | (b[1] :: Int << 16) | (b[2] :: Int << 8) | (b[3] :: Int) };

// Both-byte orders
BB_U32 -> LE_U32 BE_U32 ?[ LE_U32.value == BE_U32.value ] { value = LE_U32.value }; // 8.3.4

rule NULBytes: {};
NULBytes -> repeat NUL_BYTE.this;

NUL_BYTE -> "\x00";

Byte -> { value = . };

%postamble_begin

use std::fs;

fn main() {
    let input = fs::read("./test/node/samples/1.iso").unwrap();
    println!("{:#?}", ISO9660(&input, 0, input.len()));
}
