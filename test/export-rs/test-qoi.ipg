#![allow(non_snake_case)]
#![allow(dead_code)]
#![allow(unreachable_code)]
#![allow(unused_mut)]
#![allow(unused_assignments)]
#![allow(unused_variables)]
#![allow(non_camel_case_types)]

use image::{RgbaImage, Rgba, error::ImageResult};
use std::fs;

fn render(width: u32, height: u32, colors: &[Color], out_path: &str) -> ImageResult<()> {
    let mut img = RgbaImage::new(width, height);
    let mut i = 0;
    for y in 0 .. height {
        for x in 0 .. width {
            let color = &colors[i];
            img.put_pixel(x, y, Rgba([color.r, color.g, color.b, color.a]));
            i += 1;
        }
    }
    img.save(out_path)
}

#[derive(Clone, Copy, Debug)]
struct Color { r: u8, g: u8, b: u8, a: u8 }

#[derive(Clone, Debug)]
struct State {
    prev_color: Color,
    history: [Color; 64],
    output: Vec<Color>,
}

impl State {
    fn push(&mut self, color: Color) { self.output.push(color) }
}

fn initState(width: i64, height: i64) -> State {
    let black = Color { r: 0, g: 0, b: 0, a: 255 };
    let transparent = Color { r: 0, g: 0, b: 0, a: 0 };
    State {
        prev_color: black,
        history: [transparent; 64],
        output: Vec::with_capacity((width * height) as usize),
    }
}

fn hash(color: &Color) -> u8 {
    color.r.wrapping_mul(3)
    .wrapping_add(color.g.wrapping_mul(5))
    .wrapping_add(color.b.wrapping_mul(7))
    .wrapping_add(color.a.wrapping_mul(11)) % 64
}

fn RGB(state: &mut State, r: u8, g: u8, b: u8) {
    RGBA(state, r, g, b, state.prev_color.a)
}

fn RGBA(state: &mut State, r: u8, g: u8, b: u8, a: u8) {
    let color = Color { r, g, b, a };
    state.prev_color = color;
    state.history[hash(&color) as usize] = color;
    state.push(color);
}

fn Index(state: &mut State, index: u8) {
    let color = state.history[index as usize];
    state.prev_color = color;
    state.push(color);
}

fn Diff(state: &mut State, dr: u8, dg: u8, db: u8) {
    RGB(
        state,
        state.prev_color.r.wrapping_add(dr),
        state.prev_color.g.wrapping_add(dg),
        state.prev_color.b.wrapping_add(db),
    )
}

fn Luma(state: &mut State, diffGreen: u8, drdg: u8, dbdg: u8) {
    RGB(
        state,
        state.prev_color.r.wrapping_add(drdg).wrapping_add(diffGreen),
        state.prev_color.g.wrapping_add(diffGreen),
        state.prev_color.b.wrapping_add(dbdg).wrapping_add(diffGreen),
    )
}

fn Run(state: &mut State, runLength: u8) {
    for _ in 0 .. runLength {
        state.push(state.prev_color);
    }
}

fn wrapping_sub(x: u8, y: u8) -> u8 { x.wrapping_sub(y) }

type ChunkType = ();

%preamble_end

%declare_type ChunkType State %end

// Magic types / functions.
typedef RefMut('a) = 'a;
function ref_mut(x: 'a): 'a;

function initState(width: Int, height: Int): State;
function RGB(state: State, r: U8, g: U8, b: U8): ChunkType;
function RGBA(state: State, r: U8, g: U8, b: U8, a: U8): ChunkType;
function Index(state: State, index: U8): ChunkType;
function Diff(state: State, dr: U8, dg: U8, db: U8): ChunkType;
function Luma(state: State, diffGreen: U8, drdg: U8, dbdg: U8): ChunkType;
function Run(state: State, run: U8): ChunkType;

function wrapping_sub(x: U8, y: U8): U8;

QOI
    -> QOIHeader
       { width = QOIHeader.width }
       { height = QOIHeader.height }
       { channels = QOIHeader.channels }
       { colorspace = QOIHeader.colorspace }
       { state = initState(width, height) }
       QOIChunks(ref_mut(state));

QOIHeader
    -> "qoif"
        BE_U32 { width = BE_U32.value }
        BE_U32 { height = BE_U32.value }
        { channels = . }
        { colorspace = . };

rule QOIChunks(state: RefMut(State));
QOIChunks(state) -> repeat QOIChunk(state).chunk until EndMarker;

rule QOIChunk(state: RefMut(State));
QOIChunk(state) -> { tagByte = . } Chunk(state, tagByte) { chunk = Chunk.run };

rule Chunk(state: RefMut(State), tagByte: U8): { tag: String, run: ChunkType };
Chunk(state, tagByte)
    -> ?[ tagByte == 0xFE ] { tag = "rgb" }
        { r = . } { g = . } { b = . }
        { run = RGB(state, r, g, b) }
     / ?[ tagByte == 0xFF ] { tag = "rgba" }
        { r = . } { g  = . } { b  = . } { a  = . }
        { run = RGBA(state, r, g, b, a) }
     / ?[ (tagByte >> 6) == 0 ] { tag = "index" }
        { index = tagByte & 0x3Fu8 }
        { run = Index(state, index) }
     / ?[ (tagByte >> 6) == 1 ] { tag = "diff" }
        { dr = wrapping_sub((tagByte >> 4) & 0x03u8, 2u8) }
        { dg = wrapping_sub((tagByte >> 2) & 0x03u8, 2u8) }
        { db = wrapping_sub(tagByte & 0x03u8, 2u8) }
        { run = Diff(state, dr, dg, db) }
     / ?[ (tagByte >> 6) == 2 ] { tag = "luma" }
        { diffGreen = wrapping_sub(tagByte & 0x3Fu8, 32u8) }
        U8
        { drdg = wrapping_sub(U8.value >> 4, 8u8) }
        { dbdg = wrapping_sub(U8.value & 0x0Fu8, 8u8) }
        { run = Luma(state, diffGreen, drdg, dbdg) }
     / ?[ (tagByte >> 6) == 3 ] { tag = "run" }
        { runLength = (tagByte & 0x3Fu8) + 1u8 }
        { run = Run(state, runLength) };

EndMarker -> "\x00\x00\x00\x00\x00\x00\x00\x01";

U8 -> { value = . };

BE_U32
    -> { bs = *[4] }
       { value = (bs[3] :: Int) | (bs[2] :: Int << 8) | (bs[1] :: Int << 16) | (bs[0] :: Int << 24) };

%postamble_begin

fn main() {
    let input = fs::read("./test/node/samples/1.qoi").unwrap();
    let (_, _, qoi) = QOI(&input, 0, input.len()).unwrap();
    let _ = render(qoi.width as u32, qoi.height as u32, &qoi.state.output, "./dice.png").unwrap();
}
